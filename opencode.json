{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vibe_kanban": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "vibe-kanban@latest", "--mcp"]
    },
    "mcp-context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "tractatus-thinking": {
      "type": "local",
      "command": ["npx", "-y", "tractatus_thinking@latest"]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--extension"],
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "eq5FjSJdSORqP5rJsWdqK4qyiULfxgdPU83LyKJoszU"
      }
    },
    "demongrep" : {
      "type": "local",
      "command": [ "/Users/cdumler/.bin/demongrep", "mcp", "/Users/cdumler/.config/opencode" ]
    }
  },
  "agent": {},
  "plugin": ["oh-my-opencode@latest"]
}
