{
  "$schema": "https:\/\/opencode.ai\/config.json",
  "agent": {
    "general": {
      "description": "General build agent.",
      "model": "openrouter\/deepseek\/deepseek-v4-flash",
      "variant": "128k"
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "lsp": {
    "pylsp": {
      "disabled": true
    },
    "typescript-language-server": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"],
      "priority": 10
    }
  },
  "mcp": {
    "chrome-browser": {
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "type": "local"
    },
    "mcp-context7": {
      "type": "remote",
      "url": "https:\/\/mcp.context7.com\/mcp"
    },
    "sequential-thinking": {
      "command": ["npx", "-y", "@modelcontextprotocol\/server-sequential-thinking"],
      "type": "local"
    },
    "tractatus-thinking": {
      "command": ["npx", "-y", "tractatus_thinking@latest"],
      "type": "local"
    }
  },
  "model": "openrouter\/deepseek\/deepseek-v4-flash",
  "plugin": [
    "@zenobius\/opencode-background",
    "opencode-ralph-loop",
    "opencode-cron",
    "@cortexkit\/opencode-magic-context@latest",
    "opencode-cmux",
    ".\/plugins\/cmux-session.js"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "deepseek\/deepseek-v4-flash": {
          "limit": {
            "context": 131072,
            "output": 65536
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwopus3.5-9b-coder": {
          "name": "Qwopus 3.5 9B Coder",
          "limit": {
            "context": 65535,
            "output": 65535
          }
        },
        "google/gemma-4-e2b": {
          "name": "GEMMA 4 E2B",
          "limit": {
            "context": 65535,
            "output": 65535
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://10.0.1.225:11434/v1"
      },
      "models": {
        "maxwell1500/ornith-9b:Q8_0": {
          "name": "Ornith 9B",
          "limit": {
            "context": 65535,
            "output": 65535
          }
        },
        "negoncio/qwopus-coder:latest": {
          "name": "Qwopus 3.5 Coder"
        },
        "adelnazmy2002/Qwen3-VL-4B-Instruct:Q4_K_M": {
          "name": "Qwen3-VL-4B-Instruct"
        },
        "gemma4:e2b": {
          "name": "Gemma4:E2B"
        },
        "llama3.2": {
          "name": "llama3.2:3b"
        }
      }
    }
  },
  "small_model": "openrouter\/deepseek\/deepseek-v4-flash",
  "watcher": {
    "ignore": ["**\/node_modules\/**", "**\/.git\/**"]
  }
}
